# Maintainer build and compatibility test; consumers do not need this
# Dockerfile or any Alpine packages to use Glimt.
FROM bellsoft/hardened-liberica-runtime-container:jdk-all-26-musl AS jdk
RUN cp -a "$JAVA_HOME" /jdk-copy

FROM alpine:3.23 AS tested
RUN apk add --no-cache build-base cmake ninja nasm python3 py3-pip pkgconf patchelf patch git perl linux-headers fontconfig freetype
COPY --from=jdk /jdk-copy /opt/jdk
ENV JAVA_HOME=/opt/jdk PATH=/opt/jdk/bin:/opt/tools/bin:$PATH
RUN python3 -m venv /opt/tools && /opt/tools/bin/pip install meson==1.10.0
WORKDIR /work
COPY . .
RUN python3 native/build.py --platform linux-x64-musl --jobs 4
RUN ./gradlew build --no-daemon
RUN python3 tools/runtime-smoke.py --platform linux-x64-musl --prepare-only
RUN jlink --add-modules java.base --no-header-files --no-man-pages --output /smoke-runtime

FROM bellsoft/hardened-base:musl AS clean-runtime
COPY --from=tested /smoke-runtime /opt/java
COPY --from=tested /work/build/runtime-smoke/lib /smoke/lib
COPY --from=tested /work/build/runtime-smoke/corpus /smoke/corpus
RUN ["/opt/java/bin/java", "--enable-native-access=no.beint.glimt", "--illegal-native-access=deny", "--module-path", "/smoke/lib", "-m", "no.beint.glimt.smoke/no.beint.glimt.smoke.Main", "/smoke/corpus"]
RUN ["/opt/java/bin/java", "--enable-native-access=ALL-UNNAMED", "--illegal-native-access=deny", "-cp", "/smoke/lib/*", "no.beint.glimt.smoke.Main", "/smoke/corpus"]
